{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "preview/b4-integrated-takeoff-performance": true
