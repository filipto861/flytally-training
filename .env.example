# FlyTally Training owns its own PostgreSQL database. Do not point this at the Logbook database.
TRAINING_DATABASE_URL=

# Training-local session signing secret (minimum 32 characters).
TRAINING_SESSION_SECRET=

# Shared only with the FlyTally identity issuer. Used for short-lived SSO assertions.
FLYTALLY_IDENTITY_SECRET=

# Base URL of FlyTally Logbook, e.g. https://app.fly-tally.com
FLYTALLY_LOGBOOK_URL=

# static = source-file bootstrap adapter, postgres = approved/published content from Training DB.
TRAINING_CONTENT_BACKEND=static

# AI drafting is admin-only and can create drafts only. It cannot approve or publish content.
TRAINING_DRAFTING_PROVIDER=openai
OPENAI_API_KEY=
TRAINING_DRAFTING_MODEL=gpt-5.6-terra

# Controlled manual PDFs use a PRIVATE Vercel Blob store.
# On Vercel, prefer the deployment-provided VERCEL_OIDC_TOKEN (automatic rotation).
# For local development or non-Vercel execution, BLOB_READ_WRITE_TOKEN is the supported fallback.
# VERCEL_OIDC_TOKEN is normally injected by Vercel and should not be copied into project source.
BLOB_READ_WRITE_TOKEN=

# Mandatory only when running `npm run test:no-code-aircraft`.
# Use a disposable/preview Training database, never the production database.
TRAINING_ACCEPTANCE_DATABASE_URL=
